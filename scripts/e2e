#!/usr/bin/env bash
SPEC_ARG=""

# check if script invoke contains any argument. If so, add spec to run
if [ $# -eq 1 ]; then
  echo "Running e2e tests with spec: $1"
  SPEC_ARG="--spec ${1}"
fi

# Run the specs tagged @parallel with several Cypress processes, see scripts/e2e-parallel
if [ $# -eq 0 ] && [ -n "$GREP_TAGS" ] && [ "${E2E_PARALLEL_WORKERS:-1}" -gt 1 ]; then
  exec node "$(dirname "$0")/e2e-parallel"
fi

CYPRESS_GREP_TAGS_ARGS=""

if [ -n "$GREP_TAGS" ]; then
  echo "Running Cypress with grep tags: $GREP_TAGS"
  # @cypress/grep v6 reads its settings from `expose`, not `env`
  CYPRESS_GREP_TAGS_ARGS="--expose grepTags=\"$GREP_TAGS\""
else
  echo "Running Cypress without grep tags"
fi

# Construct the full command
E2E_COMMAND="cypress run ${SPEC_ARG} ${CYPRESS_GREP_TAGS_ARGS} --browser chrome"

# Execute the command
eval $E2E_COMMAND
